OPENAI_API_KEY=your_api_key_here
# Optional; defaults to the model used in the current OpenAI quickstart.
OPENAI_MODEL=gpt-6-astra
# Optional; the faster image model is a good hackathon default.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Set this to a long random value in deployed environments.
SAFETY_IDENTIFIER_SALT=replace_with_a_random_secret
