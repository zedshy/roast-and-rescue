OPENAI_API_KEY=your_api_key_here
# Optional; conservative current model for vision + Structured Outputs.
OPENAI_MODEL=gpt-5.4-nano
# Optional; image generation is only called when the user explicitly requests a concept.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Set this to a long random value in deployed environments.
SAFETY_IDENTIFIER_SALT=replace_with_a_random_secret
